okeColor=#64748B;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" parent="1" source="step3" target="step4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seq4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;fontColor=#334155;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=classic;endFill=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" parent="1" source="step4" target="step5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="seq5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;fontColor=#334155;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=classic;endFill=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" parent="1" source="step5" target="step6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="footer" value="&lt;b&gt;Security &amp; deployment notes:&lt;/b&gt; WAF default-block + approved IP set; use a stable public egress IP. Lambda validates XML and rejects unsafe input. DummyJSON is a mock API (no persistent writes). Add Secrets Manager only if a real vendor API requires credentials. Apply separately to dev and prod with separate Terraform state keys." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#475569;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1700" height="58" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>